{
  "name": "api-libros-aws",
  "version": "1.1.0",
  "description": "API REST para gestion de libros en Amazon EC2 con persistencia en Amazon RDS MySQL y CI/CD",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --runInBand --detectOpenHandles --forceExit",
    "test:coverage": "jest --coverage --runInBand --detectOpenHandles --forceExit"
  },
  "keywords": [
    "nodejs",
    "express",
    "mysql",
    "aws",
    "ec2",
    "rds",
    "docker",
    "ci-cd",
    "github-actions"
  ],
  "author": "Brayan Mario Vargas Alarcon",
  "license": "ISC",
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "mysql2": "^3.12.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 10000,
    "collectCoverageFrom": [
      "app.js",
      "!node_modules/**"
    ]
  }
}
